# Mẫu bí mật cho canh-tin-vinhlong. Chép sang ~/.config/canhtin-vinhlong.env trên
# bera-saas và đặt quyền 0600. KHÔNG commit bản có mật khẩu thật.
#
# SMTP_PASS = App Password Gmail 16 ký tự, lấy tại myaccount.google.com/apppasswords.
# KHÔNG dùng mật khẩu Gmail chính: App Password thu hồi riêng được, và nếu server bị
# xâm nhập thì kẻ lấy được nó chỉ gửi được mail, không vào được tài khoản.
SMTP_USER=beradillc@gmail.com
SMTP_PASS=
MAIL_TO=ngochuynh1712@chauthanh.edu.vn
