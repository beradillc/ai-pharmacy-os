# STAGING — cấu hình GIỐNG PROD, dữ liệu KHÔNG phải của bệnh nhân thật.
#
#   cp .env.staging.example .env.staging   →  rồi ĐIỀN các chỗ __set_me__
#
# ⚠️ Nguyên tắc của môi trường này: staging **khác prod đúng hai thứ** — dữ liệu, và
# APP__ENV=staging. Mọi cổng an toàn khác bật y như prod. Nới một cổng ở đây nghĩa là
# cổng đó **không được kiểm chứng ở đâu cả** trước khi gặp bệnh nhân thật.

APP__ENV=staging
# false y như prod: APP__DEBUG=true bật SQL echo, in tham số (họ tên, SĐT, chẩn đoán)
# ra log — Luật BVDLCN 91/2025. Staging có dữ liệu giả, nhưng thói quen thì mang sang thật.
APP__DEBUG=false

DB__URL=postgresql+asyncpg://pharma:__set_me__@postgres:5432/pharmacy_os_staging
DB__POOL_SIZE=10
REDIS__URL=redis://redis:6379/0

# --- Bảo mật ---------------------------------------------------------------
# ≥32 BYTE (A-02). Sinh: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=__set_me__
SECURITY__ALLOW_DEV_AUTH=false
# F-9: bật y như prod. Staging là nơi duy nhất đo được hạn mức có chặn nhầm người thật không.
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__RATE_LIMIT_LOGIN_ATTEMPTS=10
SECURITY__RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# 2FA: bật ở staging để diễn tập luồng step-up trước khi ép ở prod.
SECURITY__TWO_FACTOR_ENFORCED=true

AI__API_KEY=__set_me__

# --- Mã hoá at-rest (F-8) ---------------------------------------------------
# Đây là LÝ DO CHÍNH staging tồn tại: chạy hết trình tự docs/18 phần B trên một CSDL
# CÓ DỮ LIỆU, rồi diễn tập khôi phục lại. Cả trình tự đó chưa ai đi hết một lần.
# Sinh khoá (HAI khoá khác nhau — một khoá một mục đích):
#   python -c "from pharmacy_os.core.security.crypto import generate_key, encode_key; print(encode_key(generate_key()))"
ENCRYPTION__ENABLED=true
ENCRYPTION__KEYS={"1": "__set_me__"}
ENCRYPTION__CURRENT_VERSION=1
ENCRYPTION__BLIND_INDEX_KEY=__set_me__

# --- Outbox: hình dạng PROD, không phải hình dạng dev ------------------------
# dev để SYNC_DRAIN=true cho test tất định; prod/staging phải chạy relay thật, vì
# relay mới là thứ giao lại sự kiện còn PENDING sau sự cố — và nó chưa từng chạy dài ngày.
OUTBOX__SYNC_DRAIN=false
OUTBOX__RELAY_ENABLED=true
OUTBOX__RETENTION_ENABLED=true
OUTBOX__RETENTION_PUBLISHED_DAYS=30

# --- Liên thông CSDL Dược Quốc gia ------------------------------------------
NATIONAL_SYNC__RETRY_ENABLED=true

# --- Plugin -----------------------------------------------------------------
# 🔒 RỖNG — PILOT DECISION LOCK 2026-07-28: pilot KHÔNG có thanh toán online.
# Không thêm "vnpay" vào đây khi chưa có quyết định MỚI của Chain.
# Việc plugin này không nạp phải được KIỂM BẰNG LỆNH THẬT, không đọc file này rồi tin.
PLUGINS__ENABLED=[]
PLUGINS__CONFIG={}
