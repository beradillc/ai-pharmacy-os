# PRODUCTION — dữ liệu THẬT (Chain chốt 2026-08-04). Điền file này NGAY TRÊN MÁY
# SERVER, không bao giờ qua chat/email — mọi giá trị __set_me__ dưới đây là bí mật.
#
#   cp .env.prod.example .env.prod   →  rồi ĐIỀN các chỗ __set_me__
#
# File này gần như giống hệt .env.staging.example — đúng ý định thiết kế của dự án:
# "staging khác prod đúng hai thứ: dữ liệu, và APP__ENV". Khác đúng 3 chỗ so với
# bản staging: APP__ENV=prod, DB__URL trỏ `pharmacy_os` (không có hậu tố _staging),
# và mọi khoá/mật khẩu PHẢI là giá trị MỚI — không dùng lại bất kỳ khoá nào đã sinh
# cho staging hay dev.

APP__ENV=prod
# BẮT BUỘC false — bật debug in cả SQL lẫn tham số (họ tên, SĐT, chẩn đoán) ra log,
# vi phạm Luật BVDLCN 91/2025.
APP__DEBUG=false

# Mật khẩu PHẢI khớp đúng $PROD_DB_PASSWORD dùng khi chạy `podman-compose` (xem
# docker-compose.prod.yml) — hai nơi không tự đồng bộ với nhau, gõ tay cả hai.
DB__URL=postgresql+asyncpg://pharma:__set_me__@postgres:5432/pharmacy_os
DB__POOL_SIZE=10
REDIS__URL=redis://redis:6379/0

# --- Bảo mật ---------------------------------------------------------------
# ≥32 byte. Sinh: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=__set_me__
SECURITY__ALLOW_DEV_AUTH=false
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__RATE_LIMIT_LOGIN_ATTEMPTS=10
SECURITY__RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
SECURITY__TWO_FACTOR_ENFORCED=true

# Chưa dùng AI thật ở đợt triển khai đầu (ROADMAP V4 tầng A còn chặn ở khoá này —
# xem PROJECT_STATE). Để trống/giá trị giả cũng được, MockLLMProvider vẫn chạy —
# chỉ cần điền khoá thật khi Chain quyết mở tầng AI.
AI__API_KEY=__set_me__

# --- Mã hoá at-rest ----------------------------------------------------------
# HAI khoá KHÁC NHAU — một khoá một mục đích, không dùng chung:
#   python3 -c "from pharmacy_os.core.security.crypto import generate_key, encode_key; print(encode_key(generate_key()))"
# Chạy 2 lần riêng cho ENCRYPTION__KEYS và ENCRYPTION__BLIND_INDEX_KEY.
# 🔴 Sinh và lưu khoá TRƯỚC KHI có dữ liệu thật đầu tiên — đổi khoá sau khi đã có
# dữ liệu mã hoá cần chạy runbook xoay khoá (docs/18_RUNBOOK_BACKUP_RESTORE.md),
# không phải sửa file này rồi khởi động lại.
ENCRYPTION__ENABLED=true
ENCRYPTION__KEYS={"1": "__set_me__"}
ENCRYPTION__CURRENT_VERSION=1
ENCRYPTION__BLIND_INDEX_KEY=__set_me__

# --- Outbox ------------------------------------------------------------------
OUTBOX__SYNC_DRAIN=false
OUTBOX__RELAY_ENABLED=true
OUTBOX__RETENTION_ENABLED=true
OUTBOX__RETENTION_PUBLISHED_DAYS=30

# --- Liên thông CSDL Dược Quốc gia ------------------------------------------
NATIONAL_SYNC__RETRY_ENABLED=true

# --- Plugin -----------------------------------------------------------------
# 🔒 RỖNG — PILOT DECISION LOCK 2026-07-28: pilot KHÔNG có thanh toán online.
# Không thêm "vnpay" vào đây khi chưa có quyết định MỚI của Chain.
PLUGINS__ENABLED=[]
PLUGINS__CONFIG={}
