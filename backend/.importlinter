[importlinter]
root_package = pharmacy_os
include_external_packages = True

[importlinter:contract:layers]
name = Hexagonal layers (kernel-ready; module layers added per-module)
type = layers
layers =
    pharmacy_os.api
    pharmacy_os.modules
    pharmacy_os.core
    pharmacy_os.shared

[importlinter:contract:kernel-knows-no-business]
name = Core kernel must not import business modules
type = forbidden
source_modules =
    pharmacy_os.core
forbidden_modules =
    pharmacy_os.modules

[importlinter:contract:shared-is-leaf]
name = Shared must not import core/modules/api
type = forbidden
source_modules =
    pharmacy_os.shared
forbidden_modules =
    pharmacy_os.core
    pharmacy_os.modules
    pharmacy_os.api

[importlinter:contract:catalog-domain-innermost]
name = Catalog domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.catalog.domain
forbidden_modules =
    pharmacy_os.modules.catalog.application
    pharmacy_os.modules.catalog.infrastructure
    pharmacy_os.modules.catalog.interface
    fastapi
    sqlalchemy

[importlinter:contract:inventory-domain-innermost]
name = Inventory domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.inventory.domain
forbidden_modules =
    pharmacy_os.modules.inventory.application
    pharmacy_os.modules.inventory.infrastructure
    pharmacy_os.modules.inventory.interface
    fastapi
    sqlalchemy

[importlinter:contract:sales-domain-innermost]
name = Sales domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.sales.domain
forbidden_modules =
    pharmacy_os.modules.sales.application
    pharmacy_os.modules.sales.infrastructure
    pharmacy_os.modules.sales.interface
    fastapi
    sqlalchemy

[importlinter:contract:prescription-domain-innermost]
name = Prescription domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.prescription.domain
forbidden_modules =
    pharmacy_os.modules.prescription.application
    pharmacy_os.modules.prescription.infrastructure
    pharmacy_os.modules.prescription.interface
    fastapi
    sqlalchemy

[importlinter:contract:module-independence]
name = Business modules must not import each other directly
type = independence
modules =
    pharmacy_os.modules.catalog
    pharmacy_os.modules.inventory
    pharmacy_os.modules.sales
    pharmacy_os.modules.prescription
