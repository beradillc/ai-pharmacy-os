forbidden_modules =
    pharmacy_os.modules.iam.application
    pharmacy_os.modules.iam.infrastructure
    pharmacy_os.modules.iam.interface
    fastapi
    sqlalchemy

[importlinter:contract:module-independence]
name = Business modules must not import each other directly
type = independence
modules =
    pharmacy_os.modules.catalog
    pharmacy_os.modules.inventory
    pharmacy_os.modules.sales
    pharmacy_os.modules.prescription
    pharmacy_os.modules.compliance
    pharmacy_os.modules.clinical
    pharmacy_os.modules.crm
    pharmacy_os.modules.procurement
    pharmacy_os.modules.iam

[importlinter:contract:analytics-domain-innermost]
name = Analytics domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.analytics.domain
forbidden_modules =
    pharmacy_os.modules.analytics.application
    pharmacy_os.modules.analytics.infrastructure
    pharmacy_os.modules.analytics.interface
    fastapi
    sqlalchemy

[importlinter:contract:analytics-does-not-import-business]
name = Analytics must not import other business modules (reads via ports only)
type = forbidden
source_modules =
    pharmacy_os.modules.analytics
forbidden_modules =
    pharmacy_os.modules.catalog
    pharmacy_os.modules.inventory
    pharmacy_os.modules.sales
    pharmacy_os.modules.prescription
    pharmacy_os.modules.compliance
    pharmacy_os.modules.clinical
    pharmacy_os.modules.crm
    pharmacy_os.modules.procurement
    pharmacy_os.modules.iam

[importlinter:contract:business-does-not-import-analytics]
name = Business modules must not import analytics
type = forbidden
source_modules =
    pharmacy_os.modules.catalog
    pharmacy_os.modules.inventory
    pharmacy_os.modules.sales
    pharmacy_os.modules.prescription
    pharmacy_os.modules.compliance
    pharmacy_os.modules.clinical
    pharmacy_os.modules.crm
    pharmacy_os.modules.procurement
    pharmacy_os.modules.iam
forbidden_modules =
    pharmacy_os.modules.analytics

[importlinter:contract:payment-vnpay-does-not-import-business-modules]
name = payment_vnpay plugin must not import business modules
type = forbidden
source_modules =
    payment_vnpay
forbidden_modules =
    pharmacy_os.modules

# Enumerated, not automatic: import-linter's `forbidden` type has no "everything
# except X" primitive, so this lists every pharmacy_os.core submodule other than
# `plugins` by hand. A new core submodule needs a line added here, or this
# contract silently stops covering it — the same trade-off docs/09 §6 already
# accepted for the sibling contract above.
[importlinter:contract:payment-vnpay-only-imports-the-plugin-contract]
name = payment_vnpay plugin must only import pharmacy_os.core.plugins from core
type = forbidden
source_modules =
    payment_vnpay
forbidden_modules =
    pharmacy_os.core.security
    pharmacy_os.core.db
    pharmacy_os.core.audit
    pharmacy_os.core.context
    pharmacy_os.core.di
    pharmacy_os.core.errors
    pharmacy_os.core.events
    pharmacy_os.core.config
    pharmacy_os.core.http
    pharmacy_os.core.ai
    pharmacy_os.core.bootstrap
    pharmacy_os.core.privacy
    pharmacy_os.core.outbox
