forbidden_modules =
    pharmacy_os.modules.compliance.application
    pharmacy_os.modules.compliance.infrastructure
    pharmacy_os.modules.compliance.interface
    fastapi
    sqlalchemy

[importlinter:contract:clinical-domain-innermost]
name = Clinical domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.clinical.domain
forbidden_modules =
    pharmacy_os.modules.clinical.application
    pharmacy_os.modules.clinical.infrastructure
    pharmacy_os.modules.clinical.interface
    fastapi
    sqlalchemy

[importlinter:contract:crm-domain-innermost]
name = Crm domain must not import outer layers or frameworks
type = forbidden
source_modules =
    pharmacy_os.modules.crm.domain
forbidden_modules =
    pharmacy_os.modules.crm.application
    pharmacy_os.modules.crm.infrastructure
    pharmacy_os.modules.crm.interface
