# --- App ---
APP__ENV=dev
APP__DEBUG=true

# --- Database ---
DB__URL=postgresql+asyncpg://pharma:pharma@localhost:5432/pharmacy_os
DB__POOL_SIZE=10

# --- Redis ---
REDIS__URL=redis://localhost:6379/0

# --- AI (Claude) ---
AI__PROVIDER=anthropic
AI__MODEL_REASONING=claude-opus-4-8
AI__MODEL_FAST=claude-sonnet-5
AI__API_KEY=__set_me__
AI__MAX_TOKENS=2048
AI__MIN_CONFIDENCE=0.6
# KHÔNG còn AI__ENABLE_CLINICAL_AI: bật/tắt AI lâm sàng nay là cờ THEO TENANT
# (clinical.TenantAiSettings, Sprint 6), không phải công tắc toàn cục. Để lại
# dòng đó trong .env sẽ làm app KHÔNG KHỞI ĐỘNG ĐƯỢC (AISettings cấm key lạ).

# --- Security ---
SECURITY__JWT_SECRET=__set_me__
SECURITY__JWT_TTL_MINUTES=60
SECURITY__REFRESH_TTL_DAYS=30

# Cho phép gọi API KHÔNG cần token, dùng header X-Tenant-Id / X-Branch-Id /
# X-User-Id với TOÀN BỘ quyền. Chỉ dành cho dev/test cục bộ.
#
# Từ khi có module iam (2026-07-23), mặc định của code là **false** — nghĩa là
# nếu thiếu dòng này thì mọi request không mang `Authorization: Bearer` đều bị
# 401, kể cả demo và script cũ. Đây là chủ đích (fail-closed), không phải lỗi.
# Đặt true để chạy demo/script cũ; muốn dùng đường thật thì bỏ trống dòng này
# rồi tạo tài khoản bằng `python -m seeds.bootstrap_tenant` và đăng nhập qua
# POST /api/v1/auth/login.
#
# APP__ENV=prod + cờ này = true  ⇒  ứng dụng TỪ CHỐI khởi động.
SECURITY__ALLOW_DEV_AUTH=true
