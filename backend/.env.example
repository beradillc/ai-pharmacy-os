# --- App ---
APP__ENV=dev
APP__DEBUG=true

# --- Database ---
DB__URL=postgresql+asyncpg://pharma:pharma@localhost:5432/pharmacy_os
DB__POOL_SIZE=10

# --- Redis ---
REDIS__URL=redis://localhost:6379/0

# --- AI (Claude) ---
AI__PROVIDER=anthropic
AI__MODEL_REASONING=claude-opus-4-8
AI__MODEL_FAST=claude-sonnet-5
AI__API_KEY=__set_me__
AI__MAX_TOKENS=2048
AI__MIN_CONFIDENCE=0.6
# KHÔNG còn AI__ENABLE_CLINICAL_AI: bật/tắt AI lâm sàng nay là cờ THEO TENANT
# (clinical.TenantAiSettings, Sprint 6), không phải công tắc toàn cục. Để lại
# dòng đó trong .env sẽ làm app KHÔNG KHỞI ĐỘNG ĐƯỢC (AISettings cấm key lạ).

# --- Security ---
SECURITY__JWT_SECRET=__set_me__
SECURITY__JWT_TTL_MINUTES=60
SECURITY__REFRESH_TTL_DAYS=30

# Cho phép gọi API KHÔNG cần token, dùng header X-Tenant-Id / X-Branch-Id /
# X-User-Id với TOÀN BỘ quyền. Chỉ dành cho dev/test cục bộ.
#
# Từ khi có module iam (2026-07-23), mặc định của code là **false** — nghĩa là
# nếu thiếu dòng này thì mọi request không mang `Authorization: Bearer` đều bị
# 401, kể cả demo và script cũ. Đây là chủ đích (fail-closed), không phải lỗi.
# Đặt true để chạy demo/script cũ; muốn dùng đường thật thì bỏ trống dòng này
# rồi tạo tài khoản bằng `python -m seeds.bootstrap_tenant` và đăng nhập qua
# POST /api/v1/auth/login.
#
# APP__ENV=prod + cờ này = true  ⇒  ứng dụng TỪ CHỐI khởi động.
SECURITY__ALLOW_DEV_AUTH=true

# --- Outbox (giao sự kiện miền) ---
# Mọi UnitOfWork nay ghi sự kiện vào bảng `event_outbox` NGAY TRONG giao dịch
# nghiệp vụ. Hai công tắc dưới quyết định sự kiện rời bảng đó bằng đường nào.
#
# SYNC_DRAIN=true : publish ngay sau commit, trong cùng request (giống hệt hành vi
#   trước khi có outbox) — chỉ khác là sự kiện đã nằm trên đĩa, nên chết máy giữa
#   commit và publish không còn làm mất nó. Mặc định cho dev/test.
# RELAY_ENABLED=true : chạy tiến trình nền quét `event_outbox` — ĐÂY mới là thứ
#   giao lại những dòng còn PENDING do sự cố. Tắt mặc định vì một poller chạy
#   trong bộ test sẽ làm test mất tính tất định.
#
# PROD nên đặt: OUTBOX__SYNC_DRAIN=false + OUTBOX__RELAY_ENABLED=true
# (bật cả hai cũng hợp lệ: inline cho độ trễ thấp, relay làm lưới an toàn).
# Cả hai = false khi APP__ENV=prod ⇒ ứng dụng TỪ CHỐI khởi động (sự kiện sẽ
# nằm lại trong bảng vĩnh viễn, không ai giao).
#
# Giao hàng là AT-LEAST-ONCE: một sự kiện có thể tới subscriber 2 lần, nên mọi
# subscriber đều phải có khoá idempotent.
OUTBOX__SYNC_DRAIN=true
OUTBOX__RELAY_ENABLED=false
OUTBOX__POLL_INTERVAL_SECONDS=1.0
OUTBOX__BATCH_SIZE=100
OUTBOX__MAX_RETRIES=5

# Dọn bảng `event_outbox`. Mỗi lần bán sinh ≥3 dòng và KHÔNG có gì tự xoá,
# nên **prod BẮT BUỘC bật** RETENTION_ENABLED, nếu không bảng phình vô hạn.
# Tắt mặc định vì một cái hẹn giờ chạy trong bộ test làm test mất tính tất định.
#
# PUBLISHED: xoá sau RETENTION_PUBLISHED_DAYS ngày. Dòng outbox là hạ tầng giao
#   hàng, KHÔNG phải bằng chứng — bản ghi nghiệp vụ nằm ở bảng riêng, vết kiểm
#   toán nằm ở `audit_logs`.
# FAILED: để TRỐNG = giữ vĩnh viễn (mặc định). Đây là dấu vết duy nhất cho biết
#   có sự kiện chưa bao giờ giao được; chỉ đặt số ngày khi đã có quy trình soát
#   dead-letter thật.
# PENDING: không bao giờ bị xoá, ở mọi tuổi (chặn bằng kiểu trong code).
OUTBOX__RETENTION_ENABLED=false
OUTBOX__RETENTION_INTERVAL_SECONDS=3600
OUTBOX__RETENTION_PUBLISHED_DAYS=30
# OUTBOX__RETENTION_FAILED_DAYS=
OUTBOX__RETENTION_BATCH_SIZE=500
OUTBOX__RETENTION_MAX_BATCHES=20
