# --- App ---
APP__ENV=dev

# 🔴 APP__DEBUG=true BẬT SQL echo — mọi câu lệnh kèm THAM SỐ được in ra log.
# Trên deployment có dữ liệu thật, log đó chứa họ tên, số điện thoại, chẩn đoán
# của bệnh nhân — dữ liệu cá nhân nhạy cảm theo Luật BVDLCN 91/2025, và log
# thường được thu gom sang nơi có mức bảo vệ thấp hơn CSDL.
# Mặc định ở đây là FALSE có chủ đích (kiểm toán 2026-07-26, B-03): bật là một
# quyết định của người gỡ lỗi, không phải thứ thừa kế từ file mẫu.
APP__DEBUG=false

# --- Database ---
DB__URL=postgresql+asyncpg://pharma:pharma@localhost:5432/pharmacy_os
DB__POOL_SIZE=10

# --- Redis ---
REDIS__URL=redis://localhost:6379/0

# --- AI (Claude) ---
AI__PROVIDER=anthropic
AI__MODEL_REASONING=claude-opus-4-8
AI__MODEL_FAST=claude-sonnet-5
AI__API_KEY=__set_me__
AI__MAX_TOKENS=2048
AI__MIN_CONFIDENCE=0.6
# KHÔNG còn AI__ENABLE_CLINICAL_AI: bật/tắt AI lâm sàng nay là cờ THEO TENANT
# (clinical.TenantAiSettings, Sprint 6), không phải công tắc toàn cục. Để lại
# dòng đó trong .env sẽ làm app KHÔNG KHỞI ĐỘNG ĐƯỢC (AISettings cấm key lạ).

# --- Security ---
# 🔴 PROD: tối thiểu 32 BYTE (kiểm toán 2026-07-26, A-02 — trước đây prod khởi động
# được với khoá 3 byte). HS256 ký bằng chính chuỗi này; ngắn hơn digest SHA-256 thì
# chữ ký chỉ còn là trang trí, mà mọi phiên đăng nhập và phân quyền đứng trên nó.
# Sinh khoá: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=__set_me__
SECURITY__JWT_TTL_MINUTES=60
SECURITY__REFRESH_TTL_DAYS=30

# Cho phép gọi API KHÔNG cần token, dùng header X-Tenant-Id / X-Branch-Id /
# X-User-Id với TOÀN BỘ quyền. Chỉ dành cho dev/test cục bộ.
#
# Từ khi có module iam (2026-07-23), mặc định của code là **false** — nghĩa là
# nếu thiếu dòng này thì mọi request không mang `Authorization: Bearer` đều bị
# 401, kể cả demo và script cũ. Đây là chủ đích (fail-closed), không phải lỗi.
# Đặt true để chạy demo/script cũ; muốn dùng đường thật thì bỏ trống dòng này
# rồi tạo tài khoản bằng `python -m seeds.bootstrap_tenant` và đăng nhập qua
# POST /api/v1/auth/login.
#
# APP__ENV=prod + cờ này = true  ⇒  ứng dụng TỪ CHỐI khởi động.
SECURITY__ALLOW_DEV_AUTH=true

# --- Outbox (giao sự kiện miền) ---
# Mọi UnitOfWork nay ghi sự kiện vào bảng `event_outbox` NGAY TRONG giao dịch
# nghiệp vụ. Hai công tắc dưới quyết định sự kiện rời bảng đó bằng đường nào.
#
# SYNC_DRAIN=true : publish ngay sau commit, trong cùng request (giống hệt hành vi
#   trước khi có outbox) — chỉ khác là sự kiện đã nằm trên đĩa, nên chết máy giữa
#   commit và publish không còn làm mất nó. Mặc định cho dev/test.
# RELAY_ENABLED=true : chạy tiến trình nền quét `event_outbox` — ĐÂY mới là thứ
#   giao lại những dòng còn PENDING do sự cố. Tắt mặc định vì một poller chạy
#   trong bộ test sẽ làm test mất tính tất định.
#
# PROD nên đặt: OUTBOX__SYNC_DRAIN=false + OUTBOX__RELAY_ENABLED=true
# (bật cả hai cũng hợp lệ: inline cho độ trễ thấp, relay làm lưới an toàn).
# Cả hai = false khi APP__ENV=prod ⇒ ứng dụng TỪ CHỐI khởi động (sự kiện sẽ
# nằm lại trong bảng vĩnh viễn, không ai giao).
#
# Giao hàng là AT-LEAST-ONCE: một sự kiện có thể tới subscriber 2 lần, nên mọi
# subscriber đều phải có khoá idempotent.
OUTBOX__SYNC_DRAIN=true
OUTBOX__RELAY_ENABLED=false
OUTBOX__POLL_INTERVAL_SECONDS=1.0
OUTBOX__BATCH_SIZE=100
OUTBOX__MAX_RETRIES=5

# Dọn bảng `event_outbox`. Mỗi lần bán sinh ≥3 dòng và KHÔNG có gì tự xoá,
# nên **prod BẮT BUỘC bật** RETENTION_ENABLED, nếu không bảng phình vô hạn.
# Tắt mặc định vì một cái hẹn giờ chạy trong bộ test làm test mất tính tất định.
#
# PUBLISHED: xoá sau RETENTION_PUBLISHED_DAYS ngày. Dòng outbox là hạ tầng giao
#   hàng, KHÔNG phải bằng chứng — bản ghi nghiệp vụ nằm ở bảng riêng, vết kiểm
#   toán nằm ở `audit_logs`.
# FAILED: để TRỐNG = giữ vĩnh viễn (mặc định). Đây là dấu vết duy nhất cho biết
#   có sự kiện chưa bao giờ giao được; chỉ đặt số ngày khi đã có quy trình soát
#   dead-letter thật.
# PENDING: không bao giờ bị xoá, ở mọi tuổi (chặn bằng kiểu trong code).
OUTBOX__RETENTION_ENABLED=false
OUTBOX__RETENTION_INTERVAL_SECONDS=3600
OUTBOX__RETENTION_PUBLISHED_DAYS=30
# OUTBOX__RETENTION_FAILED_DAYS=
OUTBOX__RETENTION_BATCH_SIZE=500
OUTBOX__RETENTION_MAX_BATCHES=20

# --- Gửi lại liên thông CSDL Dược Quốc gia (docs/13 mục D.4) -----------------
# Bản ghi bị cổng DAV từ chối được xếp vào hàng đợi `national_sync_retry_tasks`
# (giữ payload thô) và xoá ngay khi cổng ACK. RETRY_ENABLED bật tiến trình nền
# rút hàng đợi đó; TẮT thì hàng đợi vẫn được ghi, chỉ là không ai gửi lại — bản
# ghi nằm chờ người POST lại tay như trước.
#
# PROD nên đặt NATIONAL_SYNC__RETRY_ENABLED=true (QĐ1867 mục I.2: liên thông
# "kịp thời"). Tắt mặc định vì poller trong bộ test làm test mất tính tất định.
#
# Số lần thử CÓ HẠN: MAX_RETRIES lượt, giãn cách BASE_BACKOFF_SECONDS × 2^(n-1)
# (mặc định ≈ 4 giờ rưỡi) rồi dòng chuyển DEAD, không tự gửi nữa — cần người xử lý.
NATIONAL_SYNC__RETRY_ENABLED=false
NATIONAL_SYNC__POLL_INTERVAL_SECONDS=30
NATIONAL_SYNC__BATCH_SIZE=20
NATIONAL_SYNC__MAX_RETRIES=8
NATIONAL_SYNC__BASE_BACKOFF_SECONDS=60
NATIONAL_SYNC__LEASE_SECONDS=300

# --- Plugin (docs/09) -------------------------------------------------------
# Khám phá tách khỏi bật/tắt: loader tìm mọi plugin ĐÃ CÀI qua entry point
# group `pharmacy_os.plugins`, nhưng chỉ nạp những key liệt kê ở đây.
# Cài package KHÔNG có nghĩa là bật.
#
# Mặc định RỖNG — không plugin nào chạy trừ khi bật có chủ đích (cùng tinh
# thần OUTBOX__RELAY_ENABLED / NATIONAL_SYNC__RETRY_ENABLED).
#
# CẢNH BÁO: bật một plugin chưa cài, sai contract, hoặc lệch major
# api_version ⇒ APP TỪ CHỐI KHỞI ĐỘNG (fail-fast, có chủ đích — xem
# docs/09 mục 6). Hỏng lúc deploy còn hơn hỏng lúc thu ngân bấm thanh toán.
PLUGINS__ENABLED=[]

# Cấu hình riêng từng plugin, khóa theo đúng tên entry point ở trên. Secret
# của plugin đặt ở đây, không hard-code trong plugin.
#
# vnpay (Sprint 8 mục 4/4, plugins/payment_vnpay) — 4 trường, xem
# payment_vnpay/config.py: tmn_code (mã merchant VNPAY cấp), hash_secret
# (TUYỆT ĐỐI KHÔNG log/commit — ký mọi request lẫn callback, lộ = giả mạo
# được giao dịch), base_url (mặc định sandbox, tự đổi sang production khi
# lên thật), return_url (nơi trình duyệt khách quay lại sau khi trả tiền —
# CHỈ hiển thị, không phải bằng chứng đã trả — bằng chứng thật là IPN
# callback đã qua xác thực chữ ký, xem SalesService.confirm_vnpay_callback).
# Ví dụ:
# PLUGINS__CONFIG={"vnpay": {"tmn_code": "...", "hash_secret": "...", \
#   "return_url": "https://pharmacy.example/checkout/return"}}
PLUGINS__CONFIG={}

# --- Mã hoá at-rest (Sprint 8 mục 3/4, docs/09 + core/security/crypto.py) ----
#
# 🔴 MẤT KHOÁ = MẤT DỮ LIỆU VĨNH VIỄN. Không có `git revert` nào cứu được:
# cột đã mã hoá trở thành không đọc được mãi mãi. Sao lưu khoá TÁCH RIÊNG khỏi
# bản dump CSDL, và DIỄN TẬP KHÔI PHỤC THÀNH CÔNG trước khi bật ở bất kỳ nơi
# nào có dữ liệu thật.
#
# TUYỆT ĐỐI KHÔNG commit, không đặt cạnh file backup, không ghi vào log.
#
# Sinh khoá:
#   python -c "from pharmacy_os.core.security.crypto import generate_key, encode_key; print(encode_key(generate_key()))"
#
# Mặc định TẮT. Bật mà thiếu khoá ⇒ app TỪ CHỐI KHỞI ĐỘNG ở MỌI môi trường
# (không riêng prod) — ghi ciphertext không ai đọc lại được là hỏng không
# khôi phục được, phải chặn ngay.
# 🔴 PROD: false ⇒ app TỪ CHỐI KHỞI ĐỘNG (kiểm toán 2026-07-26, A-03). Trước đây
# quên đặt biến này ở prod nghĩa là dữ liệu bệnh nhân nằm nguyên văn trong CSDL mà
# không ai từng quyết định điều đó. Nếu thực sự cố ý chạy prod chưa mã hoá (đang
# backfill dở), phải khai báo thành lời bằng ENCRYPTION__ALLOW_PLAINTEXT_IN_PROD=true.
ENCRYPTION__ENABLED=false

# Đường thoát CỐ Ý cho dòng trên. Mặc định false = "quên đặt thì app không chạy",
# chứ không phải "quên đặt thì dữ liệu để trần". Bật lên là quyết định có người
# chịu trách nhiệm — ghi lý do vào nhật ký vận hành.
ENCRYPTION__ALLOW_PLAINTEXT_IN_PROD=false

# Nhiều phiên bản khoá sống song song để XOAY KHOÁ không cần mã hoá lại toàn
# bộ: mỗi ciphertext mang thẻ `v1:`/`v2:`. Xoay = thêm v2, trỏ CURRENT_VERSION
# sang v2; dòng cũ vẫn đọc được bằng v1. KHÔNG được xoá khoá cũ khi còn dòng
# mang thẻ đó — lệnh backfill sẽ báo rõ "thiếu khoá v mấy".
ENCRYPTION__KEYS={}
ENCRYPTION__CURRENT_VERSION=1

# Khoá RIÊNG cho blind index (fingerprint tra cứu SĐT). Cố ý không dùng chung
# khoá mã hoá: một khoá một mục đích. Thiếu khoá này khi đã bật mã hoá ⇒ app
# từ chối khởi động, vì `find_by_phone` sẽ hỏng.
ENCRYPTION__BLIND_INDEX_KEY=__set_me__

# Quy trình bật trên deployment ĐÃ CÓ DỮ LIỆU (xem seeds/encrypt_backfill.py):
#   1. pg_dump backup, cất riêng
#   2. alembic upgrade head   (nới cột, KHÔNG đụng dữ liệu)
#   3. đặt khoá + ENCRYPTION__ENABLED=true, khởi động lại
#   4. python -m seeds.encrypt_backfill --dry-run   (đếm trước)
#   5. python -m seeds.encrypt_backfill             (mã hoá, chạy được khi đang sống)
#   6. python -m seeds.encrypt_backfill --verify    (BẮT BUỘC trước khi xoá backup)

# Số đo vận hành (F-18b). RỖNG ⇒ GET /metrics KHÔNG được mount (trả 404) — fail-closed,
# cùng tinh thần SECURITY__ALLOW_DEV_AUTH. Đặt cùng giá trị này vào METRICS_TOKEN của
# scripts/health_deadman.sh; đó là bên tiêu thụ duy nhất hôm nay.
#   openssl rand -hex 24
APP__METRICS_TOKEN=

# Tệp khoá mã hoá, TÁCH khỏi máy chủ CSDL (Chain chốt 2026-08-03). Xem
# docs/18_RUNBOOK_BACKUP_RESTORE.md §D cho các bước di trú — ĐỌC TRƯỚC KHI ĐẶT.
#
# 🔴 Khai CẢ dòng này lẫn ENCRYPTION__KEYS ⇒ ứng dụng TỪ CHỐI KHỞI ĐỘNG. Hai nguồn khoá
# cùng lúc nghĩa là không ai biết chắc bản ghi mới đang mã hoá bằng khoá nào.
# 🔴 Tệp phải ở quyền 0600. Hở hơn ⇒ ứng dụng từ chối khởi động: một tệp khoá ai cũng đọc
# được thì việc dời nó ra khỏi thư mục ứng dụng KHÔNG tách được ai khỏi dữ liệu.
# Định dạng: {"keys": {"1": "<base64>"}, "blind_index_key": "<base64>"}
#ENCRYPTION__KEYS_FILE=/etc/pharmacy-os/keys.json
